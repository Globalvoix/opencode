# Where the Thinksoft installers are downloaded from.
#
# Default: the versioned release bucket used by the desktop release workflow
# (packages/desktop/electron-builder.config.ts publishes
# opencode-desktop-${os}-${arch}.${ext} under /files/bin/<version>/).
#
# Set this to your own host once the artifacts are uploaded there, for example:
# VITE_DOWNLOAD_BASE_URL=https://thinksoft.dev/downloads/
VITE_DOWNLOAD_BASE_URL=

# Desktop version the download links point at. Must match the published version.
VITE_DESKTOP_VERSION=2.0.16

# Filename prefix of the published artifacts. Releases built before the Thinksoft
# rebrand are named opencode-desktop-*; every release built from the current
# electron-builder config is thinksoft-desktop-*. Switch this to match whatever the
# base URL above actually serves, otherwise the links 404.
VITE_ARTIFACT_PREFIX=opencode-desktop

# "proxy" serves every installer through the site's own /downloads function, which
# renames it to a Thinksoft filename (Thinksoft-Setup-x64.exe and friends) while
# streaming. Requires Cloudflare Pages Functions; leave as "direct" otherwise.
VITE_DOWNLOAD_ROUTE=direct